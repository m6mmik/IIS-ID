# Generated by ansible/roles/haproxy_passthrough.
# mode tcp = SSL passthrough. Do NOT add "ssl" on server lines:
# that would terminate TLS here and IIS would never see the ID-card cert.

global
    log stdout format raw local0
    maxconn 4096

defaults
    log global
    timeout connect 5s
    timeout client 1h
    timeout server 1h
    timeout tunnel 1h
    timeout check 2s

frontend iis_front
    mode tcp
    bind *:{{ haproxy_bind_port }}
    option tcplog
    tcp-request inspect-delay 5s
    tcp-request content capture req.ssl_sni len 64
    tcp-request content accept if { req.ssl_hello_type 1 }
    log-format "%ci:%cp [%tr] %ft %b/%s conn=%Tw/%Tc/%Tt bytes=%B term=%ts sni=%[capture.req.hdr(0)]"
    default_backend iis_backends

backend iis_backends
    mode tcp
    balance {{ haproxy_balance }}
    option httpchk GET {{ haproxy_health_path }}
    http-check expect status 200
{% if haproxy_backends | length > 0 %}
{% for b in haproxy_backends %}
    server {{ b.name }} {{ b.address }}:{{ b.port }} check port {{ b.check_port }}
{% endfor %}
{% else %}
{% for host in groups['iis'] | default([]) %}
    server {{ host }} {{ hostvars[host].ansible_host }}:{{ hostvars[host].eid_https_port | default(443) }} check port {{ hostvars[host].eid_health_port | default(8080) }}
{% endfor %}
{% endif %}

listen stats
    bind *:{{ haproxy_stats_port }}
    mode http
    stats enable
    stats uri /
    stats refresh 5s
    stats admin if TRUE
